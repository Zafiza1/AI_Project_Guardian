# AI Project Guardian backend configuration.
# Copy to backend/.env and adjust. Real environment variables override values in this file.

# REQUIRED: directories in which repositories may be registered. Separate multiple roots with ';'.
# Paths outside these roots (including via symlinks or '..') are rejected.
GUARDIAN_ALLOWED_ROOTS=D:\Projects;C:\Users\you\code

# Server binding. Keep 127.0.0.1 so the API is reachable from this machine only.
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8000

# SQLite database location (default: backend/data/guardian.db)
# GUARDIAN_DATABASE_URL=sqlite:///./data/guardian.db

# Limits for allowlisted check commands
GUARDIAN_COMMAND_TIMEOUT_SECONDS=120
GUARDIAN_GIT_TIMEOUT_SECONDS=15
GUARDIAN_MAX_OUTPUT_BYTES=64000

# Frontend origins allowed by CORS (';'-separated)
GUARDIAN_CORS_ORIGINS=http://localhost:5173;http://127.0.0.1:5173

# Background worker threads for health checks
GUARDIAN_MAX_CONCURRENT_CHECKS=2
